+def read_config(path):
+    d = json.loads(Path(path).read_text())
+    d = d.get("config", d)
+    for k, v in list(d.items()):
+        if isinstance(v, list):
+            d[k] = tuple(math.inf if x is None and k == "distance_bin_edges_m" else x for x in v)
