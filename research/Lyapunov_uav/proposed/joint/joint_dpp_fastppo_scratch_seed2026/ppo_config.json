{
  "rollout_steps": 3600,
  "update_epochs": 4,
  "batch_size": 450,
  "gamma": 0.99,
  "gae_lambda": 0.95,
  "lr": 3e-05,
  "max_grad_norm": 0.5,
  "clip_coef": 0.15,
  "value_coef": 0.5,
  "categorical_entropy_coef": 0.0005,
  "power_entropy_coef": 0.0001,
  "normalize_obs": true,
  "normalize_adv": true,
  "hidden_dims": [
    256,
    256
  ],
  "init_log_std": -1.0,
  "use_value_huber_loss": true,
  "use_value_clip": false,
  "value_clip_coef": 0.5,
  "fail_on_nan": true,
  "target_kl": 0.015,
  "device": "cuda"
}